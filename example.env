#
# .env file: Environment variables for Paperless-ngx Docker Compose configuration.
#

#
# Name of the project which adds namespace for all services and volumes
#
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-paperlessngx}
COMPOSE_NETWORK_SUBNET="${COMPOSE_NETWORK_SUBNET:-0.0.0.0/16}"
COMPOSE_NETWORK_IP_RANGE="${COMPOSE_NETWORK_IP_RANGE:-0.0.0.0/24}"
COMPOSE_NETWORK_GATEWAY="${COMPOSE_NETWORK_GATEWAY:-0.0.0.0}"

#
# Host volume and docker paths
#
HOST_VOLUME="${HOST_VOLUME:-/volume1}"
HOST_PAPERLESS_NGX_PATH="${HOST_PAPERLESS_NGX_PATH:-/volume1/docker/paperless-ngx}"

#
# Container logging settings
#
LOG_MAX_SIZE="${LOG_MAX_SIZE:-50M}"
LOG_MAX_FILE="${LOG_MAX_FILE:-3}"

#
# Container user information
#
DEFAULT_UID="${DEFAULT_UID:-1026}"
DEFAULT_GID="${DEFAULT_GID:-100}"

#
# Timezone for containers
#
TZ="${TZ:-America/New_York}"

#
# Redis environment variables
#
REDIS_TAG="${REDIS_TAG:-7}"
REDIS_MEM_LIMIT="${REDIS_MEM_LIMIT:-512m}"
REDIS_MEM_RESERVATION="${REDIS_MEM_RESERVATION:-256m}"
REDIS_CPU_SHARES="${REDIS_CPU_SHARES:-768}"
REDIS_UID="${REDIS_UID:-1026}"
REDIS_GID="${REDIS_GID:-100}"
REDIS_PASSWORD="${REDIS_PASSWORD:-redispass}"
REDIS_CONFIG_PATH="${REDIS_CONFIG_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/redis}"

#
# Postgres environment variables
#
POSTGRES_TAG="${POSTGRES_TAG:-17}"
POSTGRES_MEM_LIMIT="${POSTGRES_MEM_LIMIT:-1g}"
POSTGRES_CPU_SHARES="${POSTGRES_CPU_SHARES:-768}"
POSTGRES_HEALTHCHECK_TIMEOUT="${POSTGRES_HEALTHCHECK_TIMEOUT:-45s}"
POSTGRES_HEALTHCHECK_INTERVAL="${POSTGRES_HEALTHCHECK_INTERVAL:-10s}"
POSTGRES_HEALTHCHECK_RETRIES="${POSTGRES_HEALTHCHECK_RETRIES:-10}"
POSTGRES_DB="${POSTGRES_DB:-paperless}"
POSTGRES_USER="${POSTGRES_USER:-paperlessuser}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-paperlesspass}"
POSTGRES_CONFIG_PATH="${POSTGRES_CONFIG_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/db}"

#
# Gotenberg environment variables
#
GOTENBERG_TAG="${GOTENBERG_TAG:-latest}"

#
# Tika environment variables
#
TIKA_TAG="${TIKA_TAG:-latest}"

#
# Paperless environment variables
#
PAPERLESS_TAG="${PAPERLESS_TAG:-latest}"
PAPERLESS_MEM_LIMIT="${PAPERLESS_MEM_LIMIT:-6g}"
PAPERLESS_CPU_SHARES="${PAPERLESS_CPU_SHARES:-1024}"
PAPERLESS_HEALTHCHECK_TIMEOUT="${PAPERLESS_HEALTHCHECK_TIMEOUT:-10s}"
PAPERLESS_HEALTHCHECK_INTERVAL="${PAPERLESS_HEALTHCHECK_INTERVAL:-30s}"
PAPERLESS_HEALTHCHECK_RETRIES="${PAPERLESS_HEALTHCHECK_RETRIES:-5}"
PAPERLESS_REDIS="${PAPERLESS_REDIS:-redis://redispass@redis:6379}"
PAPERLESS_DBENGINE="${PAPERLESS_DBENGINE:-postgresql}"
PAPERLESS_DBHOST="${PAPERLESS_DBHOST:-postgres}"
PAPERLESS_EMPTY_TRASH_DIR="${PAPERLESS_EMPTY_TRASH_DIR:-../trash}"
PAPERLESS_OCR_ROTATE_PAGES_THRESHOLD="${PAPERLESS_OCR_ROTATE_PAGES_THRESHOLD:-6}"
PAPERLESS_TASK_WORKERS="${PAPERLESS_TASK_WORKERS:-1}"
PAPERLESS_ADMIN_USER="${PAPERLESS_ADMIN_USER:-adminuser}"
PAPERLESS_ADMIN_PASSWORD="${PAPERLESS_ADMIN_PASSWORD:-adminpass}"
PAPERLESS_URL="${PAPERLESS_URL:-https://paperlessngx.yourname.synology.me}"
PAPERLESS_CSRF_TRUSTED_ORIGINS="${PAPERLESS_CSRF_TRUSTED_ORIGINS:-https://paperlessngx.yourname.synology.me}"
PAPERLESS_OCR_LANGUAGE="${PAPERLESS_OCR_LANGUAGE:-eng}"
PAPERLESS_TIKA_ENABLED="${PAPERLESS_TIKA_ENABLED:-1}"
PAPERLESS_TIKA_GOTENBERG_ENDPOINT="${PAPERLESS_TIKA_GOTENBERG_ENDPOINT:-http://gotenberg:3000}"
PAPERLESS_TIKA_ENDPOINT="${PAPERLESS_TIKA_ENDPOINT:-http://tika:9998}"
PAPERLESS_WEBUI_PORT="${PAPERLESS_WEBUI_PORT:-8777}"
PAPERLESS_DATA_PATH="${PAPERLESS_DATA_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/data}"
PAPERLESS_MEDIA_PATH="${PAPERLESS_MEDIA_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/media}"
PAPERLESS_EXPORT_PATH="${PAPERLESS_EXPORT_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/export}"
PAPERLESS_CONSUME_PATH="${PAPERLESS_CONSUME_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/consume}"
PAPERLESS_TRASH_PATH="${PAPERLESS_TRASH_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/trash}"

#
# Paperless AI environment variables
#
PAPERLESS_AI_TAG="${PAPERLESS_AI_TAG:-latest}"
PAPERLESS_AI_HEALTHCHECK_TIMEOUT="${PAPERLESS_AI_HEALTHCHECK_TIMEOUT:-5s}"
PAPERLESS_AI_HEALTHCHECK_INTERVAL="${PAPERLESS_AI_HEALTHCHECK_INTERVAL:-10s}"
PAPERLESS_AI_HEALTHCHECK_START_PERIOD="${PAPERLESS_AI_HEALTHCHECK_START_PERIOD:-90s}"
PAPERLESS_AI_HEALTHCHECK_RETRIES="${PAPERLESS_AI_HEALTHCHECK_RETRIES:-3}"
PAPERLESS_AI_WEBUI_PORT="${PAPERLESS_AI_WEBUI_PORT:-3747}"
PAPERLESS_AI_CONFIG_PATH="${PAPERLESS_AI_CONFIG_PATH:-/volume1/docker/paperless-ngx/config/paperless-ai}"

#
# Ollama environment variables
#
OLLAMA_TAG="${OLLAMA_TAG:-rocm}"
OLLAMA_HEALTHCHECK_TIMEOUT="${OLLAMA_HEALTHCHECK_TIMEOUT:-5s}"
OLLAMA_HEALTHCHECK_INTERVAL="${OLLAMA_HEALTHCHECK_INTERVAL:-10s}"
OLLAMA_HEALTHCHECK_START_PERIOD="${OLLAMA_HEALTHCHECK_START_PERIOD:-30s}"
OLLAMA_HEALTHCHECK_RETRIES="${OLLAMA_HEALTHCHECK_RETRIES:-3}"
OLLAMA_MODELS="${OLLAMA_MODELS:-llama3.2}"
OLLAMA_INSTALL_MODELS="${OLLAMA_INSTALL_MODELS:-llama3.2}"
OLLAMA_HOSTNAME="${OLLAMA_HOSTNAME:-ollama.yourname.synology.me}"
OLLAMA_PORT="${OLLAMA_PORT:-11434}"
OLLAMA_DATA_PATH="${OLLAMA_DATA_PATH:-/volume1/docker/paperless-ngx/config/ollama/data}"
OLLAMA_ENTRYPOINT_PATH="${OLLAMA_ENTRYPOINT_PATH:-/volume1/docker/paperless-ngx/config/ollama/entrypoint/entrypoint.sh}"

#
# Ollama Web UI environment variables
#
OLLAMA_WEBUI_TAG="${OLLAMA_WEBUI_TAG:-0.5}"
OLLAMA_WEBUI_HEALTHCHECK_TIMEOUT="${OLLAMA_WEBUI_HEALTHCHECK_TIMEOUT:-5s}"
OLLAMA_WEBUI_HEALTHCHECK_INTERVAL="${OLLAMA_WEBUI_HEALTHCHECK_INTERVAL:-10s}"
OLLAMA_WEBUI_HEALTHCHECK_START_PERIOD="${OLLAMA_WEBUI_HEALTHCHECK_START_PERIOD:-90s}"
OLLAMA_WEBUI_HEALTHCHECK_RETRIES="${OLLAMA_WEBUI_HEALTHCHECK_RETRIES:-3}"
OLLAMA_WEBUI_BASE_URL="${OLLAMA_WEBUI_BASE_URL:-http://ollama:11434}"
OLLAMA_WEBUI_SECRET_KEY="${OLLAMA_WEBUI_SECRET_KEY:-abc123}"
OLLAMA_WEBUI_PORT="${OLLAMA_WEBUI_PORT:-8271}"
OLLAMA_WEBUI_CONFIG_PATH="${OLLAMA_WEBUI_CONFIG_PATH:-/volume1/docker/paperless-ngx/config/ollama/webui}"
