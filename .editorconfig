root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,json5}]
indent_style = space
indent_size = 2

[.github/workflows/*.{yml,yaml}]
indent_style = space
indent_size = 4

[.github/renovate.json5]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
