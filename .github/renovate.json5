{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
        'helpers:pinGitHubActionDigests',
        ':enablePreCommit',
    ],
    timezone: 'America/New_York',
    schedule: [
        '* 0-7 1 * *',
    ],
    automergeSchedule: [
        '* 0-7 1 * *',
    ],
    updateNotScheduled: false,
    prConcurrentLimit: 2,
    dependencyDashboard: {
        enabled: true,
    },
    automerge: true,
    automergeType: 'pr',
    automergeStrategy: 'squash',
    platformAutomerge: false,
    rebaseWhen: 'behind-base-branch',
    assignees: [
        'scottgigawatt',
    ],
    reviewers: [
        'scottgigawatt',
    ],
    vulnerabilityAlerts: {
        enabled: true,
        dependencyDashboardApproval: false,
        groupName: null,
        automerge: false,
        schedule: [
            'at any time',
        ],
        automergeSchedule: [
            'at any time',
        ],
        updateNotScheduled: true,
    },
    enabledManagers: [
        'custom.regex',
        'docker-compose',
        'github-actions',
        'pre-commit',
    ],
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: [
                '/^example\\.env$/',
            ],
            matchStrings: [
                '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z0-9_]+_TAG="\\$\\{[A-Z0-9_]+_TAG:-(?<currentValue>[^}]+)\\}"',
            ],
            versioningTemplate: 'docker',
        },
    ],
    packageRules: [
        {
            groupName: 'GitHub Actions',
            matchManagers: [
                'github-actions',
            ],
        },
        {
            groupName: 'Compose images',
            matchManagers: [
                'custom.regex',
                'docker-compose',
            ],
        },
        {
            groupName: 'Pre-commit hooks',
            matchManagers: [
                'pre-commit',
            ],
        },
        {
            matchUpdateTypes: [
                'minor',
                'patch',
                'pin',
                'digest',
            ],
            groupName: 'monthly maintenance',
        },
        {
            matchDatasources: [
                'docker',
            ],
            schedule: [
                '* 0-7 * * 1',
            ],
            automergeSchedule: [
                '* 0-7 * * 1',
            ],
            groupName: 'weekly production dependencies',
        },
        {
            matchUpdateTypes: [
                'major',
            ],
            dependencyDashboardApproval: true,
            automerge: false,
            groupName: null,
        },
    ],
}
