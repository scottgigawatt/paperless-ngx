#
# example.env: Complete example settings for the Paperless-ngx Compose stack.
#              Copy this file to .env, replace every change-me value, and
#              generate PAPERLESS_SECRET_KEY before starting the stack.
#

#
# Compose project and private Docker network.
#
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-paperlessngx}"
COMPOSE_NETWORK_SUBNET="${COMPOSE_NETWORK_SUBNET:-172.24.0.0/16}"
COMPOSE_NETWORK_IP_RANGE="${COMPOSE_NETWORK_IP_RANGE:-172.24.5.0/24}"
COMPOSE_NETWORK_GATEWAY="${COMPOSE_NETWORK_GATEWAY:-172.24.5.254}"

#
# Shared container settings.
#
LOG_MAX_SIZE="${LOG_MAX_SIZE:-50M}"
LOG_MAX_FILE="${LOG_MAX_FILE:-3}"
DEFAULT_UID="${DEFAULT_UID:-1026}"
DEFAULT_GID="${DEFAULT_GID:-100}"
TZ="${TZ:-America/New_York}"

#
# Redis settings.
# renovate: datasource=docker depName=docker.io/library/redis
REDIS_TAG="${REDIS_TAG:-8.8.1}"
REDIS_PASSWORD="${REDIS_PASSWORD:-change-me-redis-password}"
REDIS_HEALTHCHECK_TIMEOUT="${REDIS_HEALTHCHECK_TIMEOUT:-5s}"
REDIS_HEALTHCHECK_INTERVAL="${REDIS_HEALTHCHECK_INTERVAL:-10s}"
REDIS_HEALTHCHECK_RETRIES="${REDIS_HEALTHCHECK_RETRIES:-10}"
REDIS_CONFIG_PATH="${REDIS_CONFIG_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/redis}"

#
# PostgreSQL settings. Version 17 and below require /var/lib/postgresql/data;
# version 18 and above require /var/lib/postgresql. Never change the major
# version and data target without a reviewed database migration.
# renovate: datasource=docker depName=docker.io/library/postgres
POSTGRES_TAG="${POSTGRES_TAG:-18.4}"
POSTGRES_HEALTHCHECK_TIMEOUT="${POSTGRES_HEALTHCHECK_TIMEOUT:-45s}"
POSTGRES_HEALTHCHECK_INTERVAL="${POSTGRES_HEALTHCHECK_INTERVAL:-10s}"
POSTGRES_HEALTHCHECK_RETRIES="${POSTGRES_HEALTHCHECK_RETRIES:-10}"
POSTGRES_DB="${POSTGRES_DB:-paperless}"
POSTGRES_USER="${POSTGRES_USER:-paperlessuser}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-change-me-postgres-password}"
POSTGRES_CONFIG_PATH="${POSTGRES_CONFIG_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/db}"
POSTGRES_DATA_TARGET="${POSTGRES_DATA_TARGET:-/var/lib/postgresql}"

#
# Gotenberg document conversion settings.
# renovate: datasource=docker depName=docker.io/gotenberg/gotenberg
GOTENBERG_TAG="${GOTENBERG_TAG:-8.34.0}"
GOTENBERG_HEALTHCHECK_TIMEOUT="${GOTENBERG_HEALTHCHECK_TIMEOUT:-5s}"
GOTENBERG_HEALTHCHECK_INTERVAL="${GOTENBERG_HEALTHCHECK_INTERVAL:-30s}"
GOTENBERG_HEALTHCHECK_START_PERIOD="${GOTENBERG_HEALTHCHECK_START_PERIOD:-30s}"
GOTENBERG_HEALTHCHECK_RETRIES="${GOTENBERG_HEALTHCHECK_RETRIES:-5}"

#
# Apache Tika text extraction image.
# renovate: datasource=docker depName=docker.io/apache/tika
TIKA_TAG="${TIKA_TAG:-3.2.3.0}"

#
# Paperless-ngx settings.
# renovate: datasource=docker depName=ghcr.io/paperless-ngx/paperless-ngx
PAPERLESS_TAG="${PAPERLESS_TAG:-3.0.5}"
PAPERLESS_HEALTHCHECK_TIMEOUT="${PAPERLESS_HEALTHCHECK_TIMEOUT:-10s}"
PAPERLESS_HEALTHCHECK_INTERVAL="${PAPERLESS_HEALTHCHECK_INTERVAL:-30s}"
PAPERLESS_HEALTHCHECK_START_PERIOD="${PAPERLESS_HEALTHCHECK_START_PERIOD:-60s}"
PAPERLESS_HEALTHCHECK_RETRIES="${PAPERLESS_HEALTHCHECK_RETRIES:-5}"
PAPERLESS_REDIS="${PAPERLESS_REDIS:-redis://:change-me-redis-password@redis:6379}"
PAPERLESS_DBENGINE="${PAPERLESS_DBENGINE:-postgresql}"
PAPERLESS_DBHOST="${PAPERLESS_DBHOST:-postgres}"
PAPERLESS_EMPTY_TRASH_DIR="${PAPERLESS_EMPTY_TRASH_DIR:-../trash}"
PAPERLESS_CONSUMER_DELETE_DUPLICATES="${PAPERLESS_CONSUMER_DELETE_DUPLICATES:-true}"
PAPERLESS_OCR_MODE="${PAPERLESS_OCR_MODE:-auto}"
PAPERLESS_ARCHIVE_FILE_GENERATION="${PAPERLESS_ARCHIVE_FILE_GENERATION:-auto}"
PAPERLESS_OCR_ROTATE_PAGES_THRESHOLD="${PAPERLESS_OCR_ROTATE_PAGES_THRESHOLD:-6}"
PAPERLESS_TASK_WORKERS="${PAPERLESS_TASK_WORKERS:-1}"
PAPERLESS_ADMIN_USER="${PAPERLESS_ADMIN_USER:-admin}"
PAPERLESS_ADMIN_PASSWORD="${PAPERLESS_ADMIN_PASSWORD:-change-me-admin-password}"
PAPERLESS_SECRET_KEY="${PAPERLESS_SECRET_KEY:-change-me}"
PAPERLESS_URL="${PAPERLESS_URL:-https://paperlessngx.yourname.synology.me}"
PAPERLESS_CSRF_TRUSTED_ORIGINS="${PAPERLESS_CSRF_TRUSTED_ORIGINS:-https://paperlessngx.yourname.synology.me}"
PAPERLESS_OCR_LANGUAGE="${PAPERLESS_OCR_LANGUAGE:-eng}"
PAPERLESS_TIKA_ENABLED="${PAPERLESS_TIKA_ENABLED:-1}"
PAPERLESS_TIKA_GOTENBERG_ENDPOINT="${PAPERLESS_TIKA_GOTENBERG_ENDPOINT:-http://gotenberg:3000}"
PAPERLESS_TIKA_ENDPOINT="${PAPERLESS_TIKA_ENDPOINT:-http://tika:9998}"
PAPERLESS_WEBUI_PORT="${PAPERLESS_WEBUI_PORT:-8777}"
PAPERLESS_DATA_PATH="${PAPERLESS_DATA_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/data}"
PAPERLESS_MEDIA_PATH="${PAPERLESS_MEDIA_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/media}"
PAPERLESS_EXPORT_PATH="${PAPERLESS_EXPORT_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/export}"
PAPERLESS_CONSUME_PATH="${PAPERLESS_CONSUME_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/consume}"
PAPERLESS_TRASH_PATH="${PAPERLESS_TRASH_PATH:-/volume1/docker/paperless-ngx/config/paperless-ngx/trash}"

#
# Paperless-AI companion settings.
# renovate: datasource=docker depName=docker.io/clusterzx/paperless-ai
PAPERLESS_AI_TAG="${PAPERLESS_AI_TAG:-3.0.9}"
PAPERLESS_AI_HEALTHCHECK_TIMEOUT="${PAPERLESS_AI_HEALTHCHECK_TIMEOUT:-5s}"
PAPERLESS_AI_HEALTHCHECK_INTERVAL="${PAPERLESS_AI_HEALTHCHECK_INTERVAL:-10s}"
PAPERLESS_AI_HEALTHCHECK_START_PERIOD="${PAPERLESS_AI_HEALTHCHECK_START_PERIOD:-90s}"
PAPERLESS_AI_HEALTHCHECK_RETRIES="${PAPERLESS_AI_HEALTHCHECK_RETRIES:-3}"
PAPERLESS_AI_WEBUI_PORT="${PAPERLESS_AI_WEBUI_PORT:-3747}"
PAPERLESS_AI_CONFIG_PATH="${PAPERLESS_AI_CONFIG_PATH:-/volume1/docker/paperless-ngx/config/paperless-ai}"
